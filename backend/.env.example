# -------------------------------------------------------------------
# Development example
# -------------------------------------------------------------------
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/arbaminch_university_dev
FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace_with_a_long_random_development_secret
JWT_EXPIRES=1d
SALT_ROUNDS=10
EMAIL_USER=gmail-address@gmail.com
EMAIL_PASS=gmail-app-password
CLOUDINARY_NAME=cloudinary_cloud_name
CLOUDINARY_API_KEY=cloudinary_api_key
CLOUDINARY_API_SECRET=cloudinary_api_secret

# -------------------------------------------------------------------
# Production example
# -------------------------------------------------------------------
# NODE_ENV=production
# PORT=5000
# MONGO_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/arbaminch_university_prod?retryWrites=true&w=majority
