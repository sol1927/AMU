# Backend environment template
# -------------------------------------------------------------------
# Development example
# -------------------------------------------------------------------
NODE_ENV=development
PORT=5000
TZ=Africa/Addis_Ababa

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mysql_username
DB_PASSWORD=mysql_password
DB_NAME=arbaminch_university_dev

# EXTERNAL_DB_TABLE.
EXTERNAL_DB_HOST=127.0.0.1
EXTERNAL_DB_PORT=3306
EXTERNAL_DB_USER=external_mysql_username
EXTERNAL_DB_PASSWORD=external_mysql_password
EXTERNAL_DB_NAME=external_university_source
EXTERNAL_DB_TABLE=external_students

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:3000
# Set COOKIE_SECURE=false for plain HTTP and true for HTTPS deployments.
COOKIE_SECURE=false

# Auth
JWT_SECRET=replace_with_a_long_random_development_secret
SALT_ROUNDS=10
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=admin1234
INITIAL_CAMPUS_EMAIL=campus@example.com
INITIAL_CAMPUS_PASSWORD=campus1234
INITIAL_CAMPUS_ID=1
INITIAL_CAMPUS_NAME=Main Campus
INITIAL_CAFE_EMAIL=cafe@example.com
INITIAL_CAFE_PASSWORD=cafe1234
INITIAL_TICKER_USERNAME=ticker_staff
INITIAL_TICKER_PASSWORD=ticker1234

# Email sender
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# -------------------------------------------------------------------
# Production example
# -------------------------------------------------------------------
NODE_ENV=production
PORT=5000
TZ=Africa/Addis_Ababa

# Main DB
DB_HOST=db.example.com
DB_PORT=3306
DB_USER=production_db_user
DB_PASSWORD=production_db_password
DB_NAME=arbaminch_university_prod

# External DB
EXTERNAL_DB_HOST=external-db.example.com
EXTERNAL_DB_PORT=3306
EXTERNAL_DB_USER=external_user
EXTERNAL_DB_PASSWORD=external_password
EXTERNAL_DB_NAME=external_university_source
EXTERNAL_DB_TABLE=external_students

# Frontend
FRONTEND_URL=https://frontend.example.com
# Set COOKIE_SECURE=false for plain HTTP and true for HTTPS deployments.
COOKIE_SECURE=true

# Auth
JWT_SECRET=replace_with_a_long_random_production_secret
SALT_ROUNDS=12
INITIAL_ADMIN_EMAIL=admin@domain.com
INITIAL_ADMIN_PASSWORD=production_admin_password
INITIAL_CAMPUS_EMAIL=campus@domain.com
INITIAL_CAMPUS_PASSWORD=production_campus_password
INITIAL_CAMPUS_ID=1
INITIAL_CAMPUS_NAME=Arba Minch Campus
INITIAL_CAFE_EMAIL=cafe@domain.com
INITIAL_CAFE_PASSWORD=production_cafe_password
INITIAL_TICKER_USERNAME=production_ticker_username
INITIAL_TICKER_PASSWORD=production_ticker_password

# Email
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password